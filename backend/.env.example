PORT=5000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Copy this file to backend/.env and put YOUR OWN values there.
# backend/.env is git-ignored — never commit real passwords.

# Option 1: Cloud (Supabase) — Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@<pooler-host>:5432/postgres
# Path to the Supabase CA certificate to verify SSL (recommended)
# DB_SSL_CA=./certs/supabase-ca.crt

# Option 2: Local PostgreSQL (comment out DATABASE_URL above)
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=<your-local-password>
# DB_NAME=smart_id_system
# DB_PORT=5432
# DB_SSL=false

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<paste-a-random-64-character-secret-here>
JWT_EXPIRES_IN=8h

# ─── Seeding (npm run seed) ───────────────────────────────────────────────────
# Password given to the demo admin accounts. If empty, a random one is generated and printed.
# SEED_ADMIN_PASSWORD=

# ─── Tests (npm test) ─────────────────────────────────────────────────────────
# Integration tests WIPE and re-seed this database. Never point it at the real/demo database.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/sifs_test
