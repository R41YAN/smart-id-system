PORT=5000

# PostgreSQL Configuration
# Option 1: Direct Connection URL (e.g. Supabase / Neon / Render)
# DATABASE_URL=postgresql://postgres.xxxx:your_actual_password_here@aws-0-region.pooler.supabase.com:6543/postgres

# Option 2: Individual variables (Local Postgres)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=smart_id_system
DB_PORT=5432

# Authentication
JWT_SECRET=replace_with_your_own_jwt_secret_key
JWT_EXPIRES_IN=7d
